flowchart LR
  resident["E1 Resident / mobile user"]
  staff["E2 CESD staff / administrator"]

  p1(["1.0 Identity and access"])
  p2(["2.0 Acquire and prepare image"])
  p3(["3.0 Detect scene objects"])
  p4(["4.0 Classify material and reject unknown"])
  p5(["5.0 Assess item and handling route"])
  p6(["6.0 Match upcycling guidance"])
  p7(["7.0 Start project and track steps"])
  p8(["8.0 Return scan history and results"])
  p9(["9.0 Provide local content and collection info"])
  p10(["10.0 Review and export dataset images"])
  p11(["11.0 Record evaluation cases and judgments"])
  p12(["12.0 Manage CESD content and reports"])

  d1[("D1 Identity records\nauth_user, Profile, ApiToken, StaffAccess")]
  d2[("D2 Scan records\nScanScene, SceneItem, PredictionRecord, IdentificationReview")]
  d3[("D3 Guidance and CESD content\nGuidance, CollectionNotice, Policy, Material, Schedule, Announcement, Activity, LegacyImport")]
  d4[("D4 Started projects\nUserProject")]
  d5[("D5 Dataset review\nDatasetImage, label groups / aliases, DatasetAudit, DatasetExport")]
  d6[("D6 Evaluation records\nEvaluationRun, EvaluationCase, RecommendationJudgment")]
  d7[("D7 Local media files\nImages and attachments referenced by file-path fields")]
  d8[("D8 Local model artifacts\nSNAPTURE_ML weights, labels, active pointer and configs")]

  resident -->|"credentials and API calls"| p1
  p1 <-->|"user identity and token records"| d1
  p1 -->|"authenticated resident or staff context"| p2
  p1 -->|"authenticated history or project request"| p7
  p1 -->|"authenticated content management request"| p12
  resident -->|"camera or gallery image and scan request"| p2
  p2 -->|"prepared image, dimensions, quality and privacy status"| p3
  p2 -->|"image bytes and privacy-safe stored image path"| d7
  p2 -->|"scene metadata and processing state"| d2
  p3 <-->|"detector weights and configuration"| d8
  p3 -->|"candidate boxes and object names"| p4
  p4 <-->|"classifier weights, labels, active version and threshold"| d8
  p4 -->|"category prediction, confidence or unknown_unsupported"| p5
  p4 -->|"prediction record and linked scene item"| d2
  p5 <-->|"published category rules and disposal guidance"| d3
  p5 -->|"user condition, contents, quantity and answers"| d2
  p5 -->|"supported item and eligibility context"| p6
  p6 <-->|"published project guidance and requirements"| d3
  p6 -->|"recommendations or no-match explanation snapshot"| d2
  resident -->|"project selection and completed-step updates"| p7
  p7 <-->|"project snapshot and step progress"| d4
  p7 -->|"source prediction and selected project reference"| d2
  p8 <-->|"per-user scan history and results"| d2
  p8 -->|"image reference for authorized display"| d7
  p8 -->|"history and scan result"| resident
  p9 <-->|"published collection notices and schedules"| d3
  p9 -->|"current local information"| resident
  resident -->|"consented image review response"| p10
  staff -->|"image decisions, corrections, rights and quality review"| p10
  p10 <-->|"review status, groups, audit and export manifest"| d5
  p10 <-->|"approved scan source and review snapshot"| d2
  p10 -->|"approved dataset image or rejection state"| d7
  staff -->|"protocol, reference labels and independent judgments"| p11
  p11 <-->|"evaluation protocol, cases and judgments"| d6
  p11 <-->|"captured prediction snapshot"| d2
  staff -->|"content edits, publication and administration actions"| p12
  p12 <-->|"role, staff access and audit actor"| d1
  p12 <-->|"policies, materials, schedules, announcements, guidance and notices"| d3
  p12 -->|"management dashboards and reporting views"| staff

  note["Boundary note: CESD is a module in the same Django backend/database, not a remote service. Source URLs in guidance are references; no external recommendation API is called. D7 and D8 are filesystem artifacts, not relational database tables."]:::note
