DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
SNAPTURE_ML_DIR=
TZ=

# Database (SQLite is the default for local development.)
SNAPTURE_DB_ENGINE=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=

# Web admin shares this API/database with Android.
ADMIN_WEB_URL=http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Development password mail is saved to SNAPTURE_BACKEND/.local/mail.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@snapture.local

# Cloud vision: set only on the backend, never in Android or source control.
# Explicitly enables sending assessment photos to the selected provider.
OPENAI_API_KEY=
SNAPTURE_CLOUD_PHOTOS_ENABLED=false
SNAPTURE_VISION_MODEL=
SNAPTURE_VISUAL_ASSESSOR=upcycling.cloud_vision.assess
# Set only after real-image evaluation; API connectivity is not validation.
SNAPTURE_VISUAL_ASSESSOR_VALIDATION={}

# Free local inference alternative (runs on the laptop, not on Android).
# SNAPTURE_VISUAL_ASSESSOR=upcycling.local_vision.assess
SNAPTURE_LOCAL_VISION_MODEL=qwen3-vl:2b
